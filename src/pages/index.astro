---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import type { Abteilung } from '../data/abteilungen';
import {
  VEREIN,
  abteilungUrl,
  beitraege,
  beitraegeUrl,
  beitragUrl,
  datum,
  isoDatum,
  spielergebnis,
} from '../lib/site';

const alle = await beitraege();

// Aufmacher-Karussell: alle im CMS als „Auf der Startseite hervorheben“ markierten Beiträge, neueste zuerst
const aufmacher = alle.filter((b) => b.data.aufmacher);
const aufmacherIds = new Set(aufmacher.map((b) => b.id));

// Ergebnisleiste: die letzten Spielberichte mit erkennbarem Ergebnis im Titel
const ergebnisse = (await beitraege('Fußball'))
  .map((b) => ({ b, e: spielergebnis(b.data.title) }))
  .filter((x) => x.e)
  .slice(0, 8);
const AUSGANG = { sieg: 'Sieg', remis: 'Unentschieden', niederlage: 'Niederlage' };

const BLOECKE: Abteilung[] = ['Hauptverein', 'Fußball', 'Freizeitsport'];
const ANZAHL = 5;
const bloecke = await Promise.all(
  BLOECKE.map(async (a) => ({
    abteilung: a,
    liste: (await beitraege(a)).filter((b) => !aufmacherIds.has(b.id)).slice(0, ANZAHL),
  })),
);
const sponsoren = (await getEntry('sponsoren', 'sponsoren'))?.data.sponsoren ?? [];
---

<Layout>
  <h1 class="visually-hidden">{VEREIN.name}</h1>

  {
    aufmacher.length > 0 && (
      <section class="aufmacher" aria-roledescription="Karussell" aria-label="Aktuelles vom VfB">
        <div class="container">
          <ul class="aufmacher__spur" id="aufmacher-spur" aria-live="off">
            {aufmacher.map((b, i) => (
              <li
                class="aufmacher__folie"
                aria-roledescription="Folie"
                aria-label={`${i + 1} von ${aufmacher.length}: ${b.data.title}`}
              >
                <div class="aufmacher__inner">
                  <div class="aufmacher__text">
                    <div class="meta">
                      <time datetime={isoDatum(b.data.date)}>{datum(b.data.date)}</time>
                      <a class="marke" href={abteilungUrl(b.data.abteilung)} tabindex={i === 0 ? undefined : -1}>
                        {b.data.abteilung}
                      </a>
                    </div>
                    <h2>
                      <a href={beitragUrl(b)} title={b.data.title} tabindex={i === 0 ? undefined : -1}>
                        {b.data.title}
                      </a>
                    </h2>
                    <a class="knopf knopf--hell" href={beitragUrl(b)} tabindex={i === 0 ? undefined : -1}>
                      Beitrag lesen
                    </a>
                  </div>
                  {b.data.cover && (
                    <a class="aufmacher__bild" href={beitragUrl(b)} tabindex="-1" aria-hidden="true">
                      <img
                        src={b.data.cover}
                        alt=""
                        decoding="async"
                        loading={i === 0 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : undefined}
                      />
                    </a>
                  )}
                </div>
              </li>
            ))}
          </ul>
          {aufmacher.length > 1 && (
            <div class="aufmacher__steuerung" id="aufmacher-steuerung">
              <button type="button" data-schritt="-1" aria-label="Vorheriger Beitrag">
                ‹
              </button>
              <div class="aufmacher__punkte">
                {aufmacher.map((b, i) => (
                  <button
                    type="button"
                    class="aufmacher__punkt"
                    data-folie={i}
                    aria-label={`Beitrag ${i + 1}: ${b.data.title}`}
                    aria-current={i === 0 ? 'true' : 'false'}
                  />
                ))}
              </div>
              <button type="button" data-schritt="1" aria-label="Nächster Beitrag">
                ›
              </button>
              <button type="button" class="aufmacher__pause" aria-pressed="false">
                Anhalten
              </button>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    ergebnisse.length > 0 && (
      <section class="ergebnisse" aria-labelledby="ergebnisse">
        <div class="container">
          <div class="ergebnisse__kopf">
            <h2 id="ergebnisse">Spielberichte</h2>
            <a href="/fussball/beitraege/">Alle Beiträge Fußball</a>
          </div>
          <ul class="ergebnisse__liste">
            {ergebnisse.map(({ b, e }) => (
              <li>
                <a class={`ergebnis ergebnis--${e!.ausgang}`} href={beitragUrl(b)}>
                  <span class="ergebnis__kopf">
                    <span class="ergebnis__mannschaft">{e!.mannschaft}</span>
                    <span class="ergebnis__ausgang">
                      <time datetime={isoDatum(b.data.date)}>{datum(b.data.date).replace(/ \d{4}$/, '')}</time>
                      <span class="visually-hidden">, {AUSGANG[e!.ausgang]}</span>
                    </span>
                  </span>
                  <span class="ergebnis__paarung">
                    <span class:list={{ vfb: /vfb\s*tamm/i.test(e!.heim) }}>{e!.heim}</span>
                    <span class="ergebnis__tore">{e!.toreHeim}</span>
                    <span class:list={{ vfb: /vfb\s*tamm/i.test(e!.gast) }}>{e!.gast}</span>
                    <span class="ergebnis__tore">{e!.toreGast}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <div class="container">
    <div class="spalten abschnitt">
      {
        bloecke.map(({ abteilung, liste }) => (
          <section aria-labelledby={`neu-${abteilung}`}>
            <h2 id={`neu-${abteilung}`}>{abteilung}</h2>
            <ul class="kompaktliste">
              {liste.map((b) => (
                <li class:list={{ 'mit-bild': b.data.cover }}>
                  {b.data.cover && <img src={b.data.cover} alt="" loading="lazy" decoding="async" />}
                  <div>
                    <div class="meta">
                      <time datetime={isoDatum(b.data.date)}>{datum(b.data.date)}</time>
                    </div>
                    <a href={beitragUrl(b)}>{b.data.title}</a>
                  </div>
                </li>
              ))}
            </ul>
            <a class="mehr-link" href={beitraegeUrl(abteilung)}>
              Alle Beiträge {abteilung}
            </a>
          </section>
        ))
      }
    </div>

    <section class="abschnitt" aria-labelledby="mitmachen">
      <h2 id="mitmachen">Mitmachen beim VfB</h2>
      <div class="mitmachen">
        <a href="/fussball/trainingszeiten/">
          <strong>Fußball</strong>
          <span>Trainingszeiten aller Mannschaften</span>
        </a>
        <a href="/freizeitsport/wochenplan-erwachsene/">
          <strong>Freizeitsport</strong>
          <span>Wochenplan für Erwachsene</span>
        </a>
        <a href="/freizeitsport/wochenplan-kinder/">
          <strong>Kinder und Jugend</strong>
          <span>Turnen, Schwimmen, Tanzen</span>
        </a>
        <a href="/hauptverein/mitgliedsbeitraege/">
          <strong>Mitglied werden</strong>
          <span>Beiträge und Mitgliedsantrag</span>
        </a>
      </div>
    </section>

    <section class="abschnitt" aria-labelledby="sponsoren">
      <h2 id="sponsoren">Unsere Sponsoren</h2>
      <ul class="sponsoren sponsoren--spur" id="sponsoren-spur">
        {
          sponsoren.map((s) => (
            <li>
              {s.url ? (
                <a href={s.url} rel="noopener">
                  <img src={s.logo} alt={s.name} loading="lazy" decoding="async" />
                </a>
              ) : (
                <span>
                  <img src={s.logo} alt={s.name} loading="lazy" decoding="async" />
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="abschnitt anfahrt" aria-labelledby="anfahrt">
      <div>
        <h2 id="anfahrt">Anfahrt</h2>
        <p>
          <strong>Sportgelände und Vereinsheim</strong><br />
          {VEREIN.strasse}<br />
          {VEREIN.ort}
        </p>
        <p>
          <a class="knopf" href={VEREIN.karte} rel="noopener">Karte öffnen</a>
        </p>
      </div>
      <div>
        <h2>Kontakt</h2>
        <p>
          Telefon: <a href={`tel:${VEREIN.telefon.replace(/\D/g, '')}`}>{VEREIN.telefon}</a><br />
          E-Mail: <a href={`mailto:${VEREIN.email}`}>{VEREIN.email}</a>
        </p>
      </div>
    </section>
  </div>
</Layout>

<script>
  // Aufmacher-Karussell: Wischen/Scrollen, Pfeile, Punkte und automatischer Wechsel alle 5 s.
  // Der Wechsel läuft standardmäßig. Er pausiert nur, solange die Maus über dem Karussell ist, die
  // Tastatur darin bedient wird (sichtbarer Fokus) oder ein Finger es berührt, und lässt sich über
  // „Anhalten“ dauerhaft stoppen. Nach jeder Bedienung beginnen die 5 s von vorn.
  // Bei „Bewegung reduzieren“ wird ohne Gleitanimation umgeblättert.
  const INTERVALL = 5000;
  const spur = document.getElementById('aufmacher-spur');
  const steuerung = document.getElementById('aufmacher-steuerung');
  if (spur && steuerung) {
    const folien = [...spur.children] as HTMLElement[];
    const punkte = [...steuerung.querySelectorAll<HTMLButtonElement>('[data-folie]')];
    const pause = steuerung.querySelector<HTMLButtonElement>('.aufmacher__pause')!;
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bereich = spur.closest('section')!;
    let aktuell = 0;
    let angehalten = false;
    let maus = false;
    let tastatur = false;
    let finger = false;
    let timer: number | undefined;

    const markiere = (i: number) => {
      aktuell = i;
      punkte.forEach((p, n) => p.setAttribute('aria-current', String(n === i)));
      folien.forEach((f, n) =>
        f.querySelectorAll('a:not(.aufmacher__bild)').forEach((a) =>
          n === i ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1'),
        ),
      );
    };

    // Nächsten automatischen Wechsel planen (Zeit beginnt jedes Mal von vorn)
    const plane = () => {
      clearTimeout(timer);
      if (angehalten) return;
      timer = window.setTimeout(() => {
        if (maus || tastatur || finger || document.hidden) return plane();
        geheZu(aktuell + 1);
      }, INTERVALL);
    };

    const geheZu = (i: number) => {
      const ziel = (i + folien.length) % folien.length;
      spur.scrollTo({ left: folien[ziel].offsetLeft, behavior: ruhig ? 'auto' : 'smooth' });
      markiere(ziel);
      plane();
    };

    let scrollTimer: number | undefined;
    spur.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(() => {
        const i = Math.round(spur.scrollLeft / (folien[1].offsetLeft - folien[0].offsetLeft));
        if (i !== aktuell) {
          markiere(Math.max(0, Math.min(folien.length - 1, i)));
          plane();
        }
      }, 80);
    });

    steuerung.addEventListener('click', (e) => {
      const knopf = (e.target as HTMLElement).closest('button');
      if (!knopf) return;
      if (knopf.dataset.schritt) geheZu(aktuell + Number(knopf.dataset.schritt));
      else if (knopf.dataset.folie) geheZu(Number(knopf.dataset.folie));
    });

    const setzePause = (an: boolean) => {
      angehalten = an;
      pause.setAttribute('aria-pressed', String(an));
      pause.textContent = an ? 'Abspielen' : 'Anhalten';
      plane();
    };
    pause.addEventListener('click', () => setzePause(!angehalten));

    bereich.addEventListener('mouseenter', () => (maus = true));
    bereich.addEventListener('mouseleave', () => {
      maus = false;
      plane();
    });
    // Nur Tastaturfokus unterbricht – ein Mausklick auf Pfeil/Punkt soll das Abspielen nicht stoppen
    bereich.addEventListener('focusin', (e) => (tastatur = (e.target as HTMLElement).matches(':focus-visible')));
    bereich.addEventListener('focusout', () => (tastatur = false));
    spur.addEventListener('touchstart', () => (finger = true), { passive: true });
    spur.addEventListener('touchend', () => {
      finger = false;
      plane();
    });

    plane();
  }
</script>

<script>
  // Sponsoren-Karussell: Reihenfolge bei jedem Seitenaufruf zufällig (niemand steht dauerhaft hinten),
  // danach rückt die Leiste alle 3 s um ein Logo weiter; am Ende geht es wieder von vorn los.
  // Keine Bedienelemente; pausiert, solange die Maus darüber ist, ein Logo per Tastatur fokussiert ist
  // oder ein Finger die Leiste berührt (von Hand wischbar). Bei „Bewegung reduzieren“ ohne Gleitanimation.
  import { mischen } from '../lib/mischen';

  const INTERVALL = 3000;
  const spur = document.getElementById('sponsoren-spur');
  if (spur && spur.children.length > 1) {
    mischen(spur);
    // Chrome rastet nach dem Umsortieren wieder auf dem bisher ersten Logo ein (Scroll-Snap) – zurück an den Anfang
    spur.scrollLeft = 0;
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let maus = false;
    let tastatur = false;
    let finger = false;
    let timer: number | undefined;

    const max = () => spur.scrollWidth - spur.clientWidth;

    const weiter = () => {
      const [a, b] = spur.children as unknown as HTMLElement[];
      const ziel = spur.scrollLeft >= max() - 2 ? 0 : spur.scrollLeft + (b.offsetLeft - a.offsetLeft);
      spur.scrollTo({ left: ziel, behavior: ruhig ? 'auto' : 'smooth' });
    };

    const plane = () => {
      clearTimeout(timer);
      // Nur bewegen, wenn nicht ohnehin alle Logos sichtbar sind
      if (max() <= 2) return;
      timer = window.setTimeout(() => {
        if (!(maus || tastatur || finger || document.hidden)) weiter();
        plane();
      }, INTERVALL);
    };

    spur.addEventListener('mouseenter', () => (maus = true));
    spur.addEventListener('mouseleave', () => {
      maus = false;
      plane();
    });
    spur.addEventListener('focusin', (e) => (tastatur = (e.target as HTMLElement).matches(':focus-visible')));
    spur.addEventListener('focusout', () => (tastatur = false));
    spur.addEventListener('touchstart', () => (finger = true), { passive: true });
    spur.addEventListener('touchend', () => {
      finger = false;
      plane();
    });

    new ResizeObserver(plane).observe(spur);
  }
</script>
