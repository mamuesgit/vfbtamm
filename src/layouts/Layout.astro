---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import { ABTEILUNGEN, ABTEILUNG_SLUG, BASKETBALL_URL, FANSHOP_URL } from '../data/abteilungen';
import { VEREIN, abteilungUrl } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Der VfB Tamm 1920 e.V. – Fußball, Freizeitsport, Tischtennis und Basketball in Tamm.' } =
  Astro.props;
const seitentitel = title ? `${title} – ${VEREIN.name}` : VEREIN.name;
const pfad = Astro.url.pathname;
const aktiv = (slug: string) => pfad.startsWith(`/${slug}/`);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seitentitel}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="VfB Tamm" />
    <meta name="theme-color" content="#111111" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <header class="kopf">
      <div class="container kopf__inner">
        <a class="kopf__logo" href="/">
          <img src="/logo-negativ.png" alt="" width="185" height="240" />
          <span class="kopf__name">
            VfB Tamm 1920 e.V.
            <small>vielfältig familiär bewegend</small>
          </span>
        </a>
        <nav class="hauptnav" aria-label="Hauptnavigation">
          <ul>
            {
              ABTEILUNGEN.map((a) => (
                <li>
                  <a href={abteilungUrl(a)} aria-current={aktiv(ABTEILUNG_SLUG[a]) ? 'page' : undefined}>
                    {a}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="extern" href={BASKETBALL_URL} rel="noopener">
                Basketball<span class="visually-hidden"> (externe Seite)</span> ↗
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="fuss">
      <div class="container">
        <p class="fuss__slogan" aria-hidden="true">vielfältig familiär bewegend</p>
        <div class="fuss__grid">
          <div>
            <h2>{VEREIN.name}</h2>
            <p>
              {VEREIN.strasse}<br />
              {VEREIN.ort}<br />
              Telefon: <a href={`tel:${VEREIN.telefon.replace(/\D/g, '')}`}>{VEREIN.telefon}</a><br />
              E-Mail: <a href={`mailto:${VEREIN.email}`}>{VEREIN.email}</a>
            </p>
          </div>
          <div>
            <h2>Verein</h2>
            <ul>
              <li><a href="/hauptverein/vorstand/">Vorstand</a></li>
              <li><a href="/hauptverein/abteilungsleiter/">Abteilungsleiter</a></li>
              <li><a href="/hauptverein/mitgliedsbeitraege/">Mitgliedsbeiträge</a></li>
              <li><a href="/hauptverein/downloads/">Downloads</a></li>
            </ul>
          </div>
          <div>
            <h2>Mehr</h2>
            <ul>
              <li><a href="/hauptverein/gaststaette/">Vereinsgaststätte</a></li>
              <li><a href={FANSHOP_URL} rel="noopener">Fanshop<span class="visually-hidden"> (externe Seite)</span> ↗</a></li>
              <li><a href="/impressum/">Impressum</a></li>
              <li><a href="/datenschutz/">Datenschutz</a></li>
              <li class="app-installieren" hidden>
                <button type="button" aria-expanded="false" aria-controls="app-hinweis">Als App installieren</button>
                <p id="app-hinweis" hidden></p>
              </li>
            </ul>
          </div>
        </div>
        <p class="fuss__unten">© {new Date().getFullYear()} {VEREIN.name}</p>
      </div>
    </footer>
    <script>
      // „Als App installieren“ im Fuß: Chrome/Edge/Android zeigen den eigenen Installationsdialog,
      // andere Browser (z. B. Safari auf dem iPhone) bekommen eine kurze Anleitung.
      // Bereits als App geöffnet → der Eintrag bleibt ausgeblendet.
      const eintrag = document.querySelector<HTMLElement>('.app-installieren');
      const alsApp = matchMedia('(display-mode: standalone)').matches || (navigator as { standalone?: boolean }).standalone;
      if (eintrag && !alsApp) {
        const knopf = eintrag.querySelector('button')!;
        const hinweis = eintrag.querySelector<HTMLElement>('#app-hinweis')!;
        let dialog: (Event & { prompt: () => Promise<void> }) | null = null;
        eintrag.hidden = false;

        addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          dialog = e as typeof dialog;
        });
        addEventListener('appinstalled', () => (eintrag.hidden = true));

        const ua = navigator.userAgent;
        const ios = /iPhone|iPad|iPod/.test(ua) || (ua.includes('Macintosh') && navigator.maxTouchPoints > 1);
        const anleitung = ios
          ? 'Tippen Sie in Safari auf das Teilen-Symbol und dann auf „Zum Home-Bildschirm“.'
          : /Android/.test(ua)
            ? 'Öffnen Sie das Browsermenü (⋮) und wählen Sie „App installieren“ oder „Zum Startbildschirm hinzufügen“.'
            : 'Im Browsermenü „App installieren“ bzw. „Seite als App installieren“ wählen (z. B. in Chrome oder Edge). Safari am Mac: Ablage → „Zum Dock hinzufügen“.';

        knopf.addEventListener('click', async () => {
          if (dialog) {
            await dialog.prompt();
            dialog = null;
            return;
          }
          const offen = hinweis.hidden;
          hinweis.textContent = anleitung;
          hinweis.hidden = !offen;
          knopf.setAttribute('aria-expanded', String(offen));
        });
      }
    </script>
  </body>
</html>
